{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ileo-crm",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".lead-desk/current/assets",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ileo-crm",
    "migrations_dir": ".lead-desk/current/migrations","database_id": "5e6da703-a8b7-4727-a31e-5445b26f8a99"
  }],
  "vars": { "ENVIRONMENT": "production" },
  "observability": { "enabled": true }
}
